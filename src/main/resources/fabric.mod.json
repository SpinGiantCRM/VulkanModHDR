{
  "schemaVersion": 1,
  "id": "vulkanmod",
  "version": "${version}",
  "name": "VulkanMod HDR Fork",
  "description": "Bring Vulkan to Minecraft!",
  "authors": [
    "Collateral",
    "VulkanMod contributors",
    "SpinGiantCRM - HDR fork changes"
  ],
  "contact": {
    "homepage": "https://github.com/xCollateral/VulkanMod",
    "sources": "https://github.com/SpinGiantCRM/VulkanModHDR"
  },
  "license": "GPL-3.0",
  "icon": "assets/vulkanmod/vlogo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vulkanmod.Initializer"
    ]
  },
  "mixins": [
    "vulkanmod.mixins.json"
  ],
  "accessWidener": "vulkanmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": ["26.1", "26.1.1", "26.1.2"]
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}
