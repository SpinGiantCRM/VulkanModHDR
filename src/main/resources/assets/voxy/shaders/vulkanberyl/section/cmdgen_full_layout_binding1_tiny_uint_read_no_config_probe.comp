#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 1, std430) readonly volatile buffer MetadataUintBuffer {
    uint metadataWord;
};

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;
    uint value = metadataWord;
    if (value == 0xffffffffu) memoryBarrierBuffer();
}
